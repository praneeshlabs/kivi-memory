# ============================ MODEL PROVIDER =============================
# Sarvam is the primary stack: Indic-native chat, ASR and TTS.
#   https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Sarvam-M (24B) was retired from the chat API. These are its successors.
SARVAM_MODEL=sarvam-30b
SARVAM_FAST_MODEL=sarvam-30b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Optional fallback so the app runs before a Sarvam key exists.
GROQ_API_KEY=

DATABASE_PATH=kivi.db
KIVI_BASE_URL=http://127.0.0.1:8000

# ============================== WEB SEARCH ==============================
# Live lookups work with no key (DuckDuckGo). Tavily is faster if you have one.
SEARCH_API_KEY=

# ============================ CONNECTED APPS ============================
# APPLICATION credentials from registering Kivi with each provider. These are
# not your account password and cannot sign in as you. You authorise Kivi on
# each provider's own consent screen and can revoke it there at any time.

# Google - sign in to Kivi, plus read-only access to sent mail.
#   console.cloud.google.com/apis/credentials -> OAuth client ID -> Web app
#   Redirect URI: http://127.0.0.1:8000/api/auth/google/callback
#   Enable the Gmail API, and add yourself under OAuth consent -> Test users
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion - publish memory to a page you pick during consent.
#   notion.so/my-integrations -> new PUBLIC integration
#   Redirect URI: http://127.0.0.1:8000/api/auth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack - send yourself digests.
#   api.slack.com/apps -> OAuth & Permissions, scopes chat:write channels:read
#   Redirect URL: http://127.0.0.1:8000/api/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CHANNEL=#general
